## Missing documents suggestion logic

```typescript
// Compare current year documents with prior year
// If client had a document type last year but not this year → suggest it

export async function getMissingDocumentSuggestions(
  clientId: string,
  currentYear: number
): Promise<string[]> {
  const priorYearDocs = await getDocumentTypes(clientId, currentYear - 1)
  const currentYearDocs = await getDocumentTypes(clientId, currentYear)

  return priorYearDocs.filter(type => !currentYearDocs.includes(type))
}
```
