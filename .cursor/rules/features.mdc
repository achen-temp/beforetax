## 4.6 — Data Export

```typescript
// lib/export/csv.ts
export async function generateCSV(taxYearId: string): Promise<string> {
  const taxYear = await getTaxYearWithDocuments(taxYearId)

  const rows = [
    ['Field', 'Value', 'Source Document', 'Confidence'],
    // flatten all extracted fields into rows
    ...flattenFields(taxYear.documents)
  ]

  return rows.map(row => row.map(cell =>
    `"${String(cell).replace(/"/g, '""')}"`
  ).join(',')).join('\n')
}
```

