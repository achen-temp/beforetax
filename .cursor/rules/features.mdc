## 4.4 — CPA Review Dashboard

### What to show
- Documents grouped by tax category
- Each field with source document name
- Conflicts highlighted in amber/red
- Missing document suggestions (vs prior year)
- Items needing attention count in header

### Conflict detection logic
```typescript
// After all documents for a tax year are extracted:
// Group extracted fields by field name
// If same field appears in 2+ documents with different values → create conflict

export async function detectConflicts(taxYearId: string) {
  const documents = await getExtractedDocuments(taxYearId)

  const fieldMap: Record<string, Array<{ documentId: string; value: unknown; fileName: string }>> = {}

  for (const doc of documents) {
    for (const [fieldName, fieldData] of Object.entries(doc.extracted_data.fields || {})) {
      if (!fieldMap[fieldName]) fieldMap[fieldName] = []
      fieldMap[fieldName].push({
        documentId: doc.id,
        value: fieldData.value,
        fileName: doc.file_name,
      })
    }
  }

  // Find conflicts
  for (const [fieldName, values] of Object.entries(fieldMap)) {
    const uniqueValues = new Set(values.map(v => JSON.stringify(v.value)))
    if (uniqueValues.size > 1) {
      await createConflict(taxYearId, fieldName, values)
    }
  }
}
```

