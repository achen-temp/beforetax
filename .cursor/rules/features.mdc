## 4.3 — AI Document Extraction

### Claude API call
```typescript
// lib/claude/extract.ts
export async function extractDocument(
  fileBase64: string,
  mimeType: string,
  fileType: string
): Promise<ExtractionResult> {
  const response = await fetch('https://api.anthropic.com/v1/messages', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      model: 'claude-sonnet-4-6',
      max_tokens: 1000,
      system: `You are a tax document data extraction specialist.
Extract all fields from this ${fileType} tax document.
Return ONLY valid JSON with this structure:
{
  "document_type": "w2",
  "tax_year": 2024,
  "fields": {
    "employer_name": { "value": "Acme Corp", "confidence": 0.99 },
    "employer_ein": { "value": "12-3456789", "confidence": 0.95 },
    "wages": { "value": 75000.00, "confidence": 0.99 },
    "federal_tax_withheld": { "value": 12000.00, "confidence": 0.99 }
  },
  "notes": "Any anomalies or observations"
}
No explanation, no markdown, only JSON.`,
      messages: [{
        role: 'user',
        content: [
          {
            type: 'document',
            source: { type: 'base64', media_type: mimeType, data: fileBase64 }
          },
          { type: 'text', text: 'Extract all tax fields from this document.' }
        ]
      }]
    })
  })

  const data = await response.json()
  const text = data.content[0].text
  return JSON.parse(text)
}
```

### Always run as background job
```typescript
